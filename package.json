{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "eventsub-gateway",
  "description": "A self-hosted gateway that does all the Twitch EventSub work for you and delivers every event to your clients over a single WebSocket connection",
  "private": true,
  "author": "aysib07 <dev@aysib07.de>",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir out",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "lint:commits": "commitlint --from origin/dev --to HEAD"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "croner": "^11.0.0",
    "figlet": "^1.12.0",
    "twitch-dev-types": "^1.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-angular": "^21.2.4",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "homepage": "https://github.com/twive-app/eventsub-gateway",
  "bugs": "https://github.com/twive-app/eventsub-gateway/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twive-app/eventsub-gateway.git"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-angular"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        120
      ],
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "refactor",
          "perf",
          "style",
          "test",
          "docs",
          "build",
          "chore",
          "src",
          "ci",
          "revert"
        ]
      ],
      "scope-case": [
        1,
        "always",
        "pascal-case"
      ]
    }
  },
  "engines": {
    "bun": "1.4.4"
  }
}
